# Shopify Configuration
# The domain of your Shopify store (e.g., mystore.myshopify.com)
SHOPIFY_SHOP_URL=your-store-name.myshopify.com

# Shopify Client Credentials for Custom App Server-to-Server flow
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=shpss_your_client_secret_here

# Shopify API Version to use (defaults to 2026-07)
SHOPIFY_API_VERSION=2026-07

# OpenAI Configuration
# OpenAI API Key (starts with sk-)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# OpenAI model to use for generating description (e.g. gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o
